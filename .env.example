NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
# Local MongoDB must run as a replica set for atomic organization provisioning.
MONGODB_URI=mongodb://127.0.0.1:27017/chainproof?replicaSet=rs0
# Generate a unique random secret (32+ characters) outside source control for each environment.
AUTH_SESSION_SECRET=local-development-only-secret-do-not-use-in-production
REDIS_URL=redis://localhost:6379
# Production secrets must come from a secret manager, never source control.
