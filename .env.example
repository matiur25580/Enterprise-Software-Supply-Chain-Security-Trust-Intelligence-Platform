MONGODB_URI=mongodb://127.0.0.1:27017/chainproof
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Sigstore keyless verification policy (required to enable SLSA verification)
SIGSTORE_CERTIFICATE_ISSUER=https://token.actions.githubusercontent.com
SIGSTORE_CERTIFICATE_IDENTITY=
# Comma-separated exact SLSA builder IDs approved by this deployment
SLSA_ALLOWED_BUILDERS=

# Ed25519 private key used to sign portable release trust passports (keep in a secret manager)
RELEASE_PASSPORT_PRIVATE_KEY=
