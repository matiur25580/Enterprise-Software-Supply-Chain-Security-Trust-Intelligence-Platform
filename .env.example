NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/chainproof?replicaSet=rs0
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Configure from GitHub App webhook settings; leave empty to disable webhook intake.
GITHUB_WEBHOOK_SECRET=

# GitHub App URL slug (without owner or URL); installation remains disabled when unset.
GITHUB_APP_SLUG=

# GitHub App credentials: inject via deployment secret manager; never commit real values.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# JSON map of key IDs to Ed25519 SPKI PEM public keys. Inject via deployment secrets.
# Releases remain blocked until a matching trusted signed DSSE attestation is supplied.
# Example shape: {"ci-prod-2026":{"algorithm":"ed25519","publicKeyPem":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}}
CHAINPROOF_ATTESTATION_TRUSTED_KEYS=
