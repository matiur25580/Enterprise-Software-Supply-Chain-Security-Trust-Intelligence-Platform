{
  "name": "@chainproof/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "tsx --test src/auth/*.test.ts src/config/*.test.ts src/projects/*.test.ts src/integrations/*.test.ts",
    "db:indexes": "tsx src/scripts/create-identity-indexes.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "mongoose": "8.24.7",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.18",
    "@types/express": "5.0.2",
    "@types/node": "22.15.30",
    "tsx": "4.19.4"
  }
}