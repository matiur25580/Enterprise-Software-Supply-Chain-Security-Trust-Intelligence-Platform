{
  "name": "chainproof",
  "version": "0.1.0",
  "private": true,
  "description": "Software supply-chain security and trust intelligence platform",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && npm run typecheck:web && tsc --noEmit --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck scripts/ensure-indexes.ts scripts/evaluate-release-policy.ts scripts/verify-release-passport.ts",
    "start": "node dist/server.js",
    "user:create": "tsx scripts/create-user.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "db:indexes": "tsx scripts/ensure-indexes.ts",
    "test:integration": "vitest run apps/api/test/*.integration.test.ts --pool=forks --poolOptions.forks.singleFork",
    "policy:evaluate": "tsx scripts/evaluate-release-policy.ts",
    "passport:verify": "tsx scripts/verify-release-passport.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.10.1",
    "zod": "^3.24.2",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^8.7.5",
    "sigstore": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "pino": "^9.7.0",
    "lucide-react": "^1.77.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "@testing-library/react": "^16.1.0",
    "@types/supertest": "^6.0.2",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
