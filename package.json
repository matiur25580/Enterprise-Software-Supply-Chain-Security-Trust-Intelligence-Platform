{
  "name": "chainproof",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise software supply-chain security and trust intelligence platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "turbo": "2.9.14",
    "typescript": "5.8.3"
  }
}
